      <Arguments guiclass="ArgumentsPanel" testclass="Arguments" testname="Global Parameters" enabled="true">
        <collectionProp name="Arguments.arguments">
          <elementProp name="URL" elementType="Argument">
            <stringProp name="Argument.name">URL</stringProp>
            <stringProp name="Argument.value">${__P(URL,1)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="eventsToTrack" elementType="Argument">
            <stringProp name="Argument.name">eventsToTrack</stringProp>
            <stringProp name="Argument.value">${__P(eventsToTrack,10)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
